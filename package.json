{
    "private": true,
    "type": "module",
    "name": "lumac",
    "version": "1.0.0",
    "description": "LUMAC POS & Inventory System",
    "author": "LUMAC",
    "main": "electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "electron": "electron electron/main.js",
        "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
        "electron:build": "electron-builder --win --x64"
    },
    "build": {
        "appId": "com.lumac.pos",
        "productName": "LUMAC",
        "copyright": "Copyright © 2026 LUMAC",
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "electron/**/*",
            "public/**/*",
            "!node_modules/**/*"
        ],
        "extraResources": [],
        "win": {
            "target": [{ "target": "nsis", "arch": ["x64"] }],
            "icon": "public/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    },
    "dependencies": {
        "@headlessui/vue": "^1.7.22",
        "@heroicons/vue": "^2.1.5",
        "axios": "^1.6.4",
        "chart.js": "^4.4.3",
        "jsbarcode": "^3.12.3",
        "nprogress": "^0.2.0",
        "pinia": "^2.1.7",
        "qrcode": "^1.5.4",
        "vue": "^3.4.27",
        "vue-chartjs": "^5.3.1",
        "vue-router": "^4.3.2"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.7",
        "@vitejs/plugin-vue": "^5.0.4",
        "autoprefixer": "^10.4.19",
        "concurrently": "^9.2.4",
        "electron": "^31.7.7",
        "electron-builder": "^26.15.3",
        "laravel-vite-plugin": "^1.0.0",
        "postcss": "^8.4.38",
        "tailwindcss": "^3.4.3",
        "vite": "^5.0.0",
        "wait-on": "^8.0.5"
    }
}
